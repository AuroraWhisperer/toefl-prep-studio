  "scripts": {
    "format": "prettier --write \"frontend/**/*.{js,css,html}\" \"tests/**/*.cjs\" \"*.cjs\" \"package*.json\" .prettierrc.json",
    "format:check": "prettier --check \"frontend/**/*.{js,css,html}\" \"tests/**/*.cjs\" \"*.cjs\" \"package*.json\" .prettierrc.json",
